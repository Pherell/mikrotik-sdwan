# The controller holds decryptable device credentials, so it is never served
# over plain HTTP outside a dev loopback. Set SDWAN_DOMAIN to a real hostname
# and Caddy will provision a certificate automatically.
{$SDWAN_DOMAIN:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy ui:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
}
