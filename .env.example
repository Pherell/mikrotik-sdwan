# Copy to .env and fill in. `make secrets` prints fresh values for the three
# generated keys below.

# --- required -------------------------------------------------------------
POSTGRES_PASSWORD=
# Encrypts device credentials and link secrets at rest. Changing this makes
# every stored credential undecryptable -- rotate deliberately, not casually.
SDWAN_SECRET_KEY=
# Signs API tokens. Rotating it logs everyone out; that is all it does.
SDWAN_JWT_SECRET=
# Seeded on first boot only, when the user table is empty.
SDWAN_BOOTSTRAP_ADMIN_PASSWORD=

# --- optional -------------------------------------------------------------
SDWAN_BOOTSTRAP_ADMIN_EMAIL=admin@local
SDWAN_ENV=prod
SDWAN_DEBUG=false
# Only relevant if a browser calls the API from a DIFFERENT origin. In the
# Docker stack Caddy serves the UI and proxies /api/* from that same origin, so
# nothing is cross-origin and this setting does nothing. Leave it alone unless
# you put a separate frontend somewhere else.
SDWAN_CORS_ORIGINS=http://localhost:8080

# The address Caddy answers to. THIS MUST MATCH WHAT YOU TYPE IN THE BROWSER.
# It is not decoration: Caddy matches the request's Host against it and picks
# the TLS certificate by it, so leaving it at localhost while browsing to an IP
# fails the TLS handshake and gets you ERR_SSL_PROTOCOL_ERROR.
#
#   10.10.10.179        an IP or a private name -> Caddy signs a certificate
#                       with its own internal CA. Works everywhere; every
#                       browser warns once until you trust that root.
#   sdwan.example.com   a publicly resolvable name -> automatic Let's Encrypt
#                       certificate, no warning. Needs the ports below left at
#                       80 and 443, since that is where the ACME challenge
#                       arrives.
#
# There is no plain-HTTP setting. The controller can decrypt the credentials of
# every router you manage; a login sent in cleartext, even on a management LAN,
# hands the fleet to anyone on that LAN.
SDWAN_DOMAIN=localhost

# Published 1:1 into the Caddy container, so these are also the ports it binds.
# Change them only if something already owns 80/443 on this host, and expect to
# type the port in the URL when you do. Let's Encrypt cannot work on anything
# but 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# HSTS pins a name to HTTPS in the browser for this many seconds. Leave it at 0
# while the certificate is self-signed: with HSTS on, the browser stops offering
# the "proceed anyway" button and you cannot reach your own controller. Set
# 31536000 once SDWAN_DOMAIN is a public name with a real certificate.
SDWAN_HSTS_MAX_AGE=0
